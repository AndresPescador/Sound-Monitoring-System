# ── Ingestion API — Variables de entorno ──────────────────────────────────────
# Copiar este archivo como .env y completar los valores

# URLs directas de las dependencias. Compose reemplaza localhost por los nombres
# DNS de los servicios sobre service_internal, sin pasar por Nginx.
AUTH_SERVICE_URL=http://localhost:8081/auth/validate
PROCESSING_BACKEND_URL=http://localhost:8082/processing/measurements

# Puerto en que corre este servicio
PORT=8000
