# Dashboard Backend API — Variables de entorno
# Copiar como .env y completar antes de ejecutar

# Base de datos noise_analytics
# Con Docker Compose usa el nombre del servicio: postgres-noise:5432
# En desarrollo local usa: localhost:5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=noise_analytics
DB_USERNAME=dashboard_reader
DB_PASSWORD=replace_with_dashboard_reader_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000
CORS_ALLOWED_ORIGIN=http://localhost:3000
PUBLIC_CACHE_SECONDS=30

# Alternativa para desarrollo: DB_URL reemplaza las variables anteriores.
# Si contiene caracteres reservados, deben estar codificados como URL.
# DB_URL=postgresql+asyncpg://dashboard_reader:password@localhost:5433/noise_analytics

PORT=8083
