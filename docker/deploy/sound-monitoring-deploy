#!/usr/bin/env bash
# Root-owned deployment entrypoint for GitHub Actions. It accepts only a
# validated release archive and never reads or prints the production .env.
set -Eeuo pipefail

APP_ROOT="/opt/sound-monitoring"
RELEASE_ROOT="$APP_ROOT/releases"
STATE_ROOT="$RELEASE_ROOT/.state"
SERVICE_STATE_ROOT="$STATE_ROOT/services"
ENV_FILE="$APP_ROOT/docker/.env"
PROJECT_NAME="docker"
HEALTH_BASE_URL="http://127.0.0.1:8080"
HEALTH_CHECK_ATTEMPTS=45
HEALTH_CHECK_DELAY_SECONDS=2
RELEASE_LABEL="com.sound-monitoring.release"

log() {
  printf '[sound-monitoring-deploy] %s\n' "$*" >&2
}

die() {
  log "ERROR: $*"
  exit 1
}

usage() {
  die "usage: $0 <commit-sha> <archive-path> <sha256>"
}

[[ ${EUID} -eq 0 ]] || die "must run as root via sudo"
[[ $# -eq 3 ]] || usage

commit_sha="$1"
archive_path="$2"
expected_checksum="$3"

[[ "$commit_sha" =~ ^[0-9a-f]{40}$ ]] || die "invalid commit SHA"
[[ "$expected_checksum" =~ ^[0-9a-f]{64}$ ]] || die "invalid archive checksum"
[[ "$archive_path" == "/tmp/sound-monitoring-release-${commit_sha}.tar.gz" ]] || die "unexpected archive path"
[[ -r "$archive_path" ]] || die "release archive is not readable"
[[ -f "$ENV_FILE" ]] || die "production environment file is missing"

actual_checksum="$(sha256sum "$archive_path" | awk '{print $1}')"
[[ "$actual_checksum" == "$expected_checksum" ]] || die "archive checksum mismatch"

install -d -m 0755 "$RELEASE_ROOT"
install -d -m 0700 "$STATE_ROOT"
install -d -m 0700 "$SERVICE_STATE_ROOT"

current_file="$STATE_ROOT/current"
previous_file="$STATE_ROOT/previous"
current_release=""
if [[ -s "$current_file" ]]; then
  current_release="$(<"$current_file")"
fi

valid_release_name() {
  [[ "$1" == "bootstrap-current" || "$1" =~ ^[0-9a-f]{40}$ ]]
}

validate_stored_release() {
  local release="$1"
  valid_release_name "$release" || die "invalid stored active release"
  [[ -d "$RELEASE_ROOT/$release" ]] || die "stored active release is missing"
}

if [[ -n "$current_release" ]]; then
  validate_stored_release "$current_release"
fi

archive_has_safe_paths() {
  local entry
  while IFS= read -r entry; do
    case "$entry" in
      /*|..|../*|*/..|*/../*|./..|./../*)
        return 1
        ;;
    esac
  done < <(tar -tzf "$archive_path")
}

archive_has_safe_paths || die "archive contains an unsafe path"

release_dir="$RELEASE_ROOT/$commit_sha"
if [[ ! -d "$release_dir" ]]; then
  incoming_dir="$(mktemp -d "$RELEASE_ROOT/.incoming-${commit_sha}.XXXXXX")"
  cleanup_incoming() {
    rm -rf "$incoming_dir"
  }
  trap cleanup_incoming EXIT

  tar -xzf "$archive_path" \
    --no-same-owner \
    --no-same-permissions \
    --delay-directory-restore \
    -C "$incoming_dir"

  [[ -f "$incoming_dir/DEPLOY_MANIFEST" ]] || die "release archive has no deployment manifest"
  [[ -f "$incoming_dir/docker/docker-compose.yml" ]] || die "release archive has no Compose file"
  mv "$incoming_dir" "$release_dir"
  trap - EXIT
fi

manifest="$release_dir/DEPLOY_MANIFEST"
manifest_value() {
  local key="$1"
  awk -F= -v expected_key="$key" '$1 == expected_key { print $2; exit }' "$manifest"
}

manifest_commit="$(manifest_value commit_sha)"
database_change="$(manifest_value database_change)"
requires_manual_vps_setup="$(manifest_value requires_manual_vps_setup)"
expected_entrypoint_checksum="$(manifest_value deployment_entrypoint_sha)"
services_csv="$(manifest_value services)"

[[ "$manifest_commit" == "$commit_sha" ]] || die "manifest commit SHA does not match archive"
[[ "$database_change" == "true" || "$database_change" == "false" ]] || die "invalid database change flag"
[[ "$requires_manual_vps_setup" == "true" || "$requires_manual_vps_setup" == "false" ]] || die "invalid VPS setup flag"
[[ "$expected_entrypoint_checksum" =~ ^[0-9a-f]{64}$ ]] || die "invalid deployment entrypoint checksum"
[[ -n "$services_csv" ]] || die "deployment manifest has no service list"

installed_entrypoint_checksum="$(sha256sum "$0" | awk '{print $1}')"
[[ "$installed_entrypoint_checksum" == "$expected_entrypoint_checksum" ]] || die "installed deployment entrypoint differs from this release; run bootstrap-vps.sh manually before retrying"

if [[ "$database_change" == "true" ]]; then
  die "database or schema files changed; apply the versioned migration manually before deploying this commit"
fi

declare -a services=()
if [[ "$services_csv" != "none" ]]; then
  IFS=',' read -r -a services <<< "$services_csv"
fi

is_allowed_service() {
  case "$1" in
    auth-service|noise-processing|ingestion-api|dashboard-api|dashboard-frontend|nginx)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

for service in "${services[@]}"; do
  is_allowed_service "$service" || die "manifest requested an unsupported service"
done

compose_for_release() {
  local selected_release="$1"
  shift
  RELEASE_SHA="$selected_release" SEO_REQUIRE_SNAPSHOT="${SEO_REQUIRE_SNAPSHOT:-0}" docker compose \
    --project-name "$PROJECT_NAME" \
    --env-file "$ENV_FILE" \
    --file "$RELEASE_ROOT/$selected_release/docker/docker-compose.yml" \
    "$@"
}

service_state_file() {
  local service="$1"
  local state_name="$2"
  printf '%s/%s/%s\n' "$SERVICE_STATE_ROOT" "$service" "$state_name"
}

service_release() {
  local service="$1"
  local state_file
  state_file="$(service_state_file "$service" current)"

  if [[ -s "$state_file" ]]; then
    local release
    release="$(<"$state_file")"
    validate_stored_release "$release"
    printf '%s\n' "$release"
    return
  fi

  [[ -n "$current_release" ]] || die "no rollback baseline is available for $service"
  printf '%s\n' "$current_release"
}

service_image() {
  case "$1" in
    auth-service|noise-processing|ingestion-api|dashboard-api|dashboard-frontend)
      printf 'sound-monitoring/%s:%s\n' "$1" "$2"
      ;;
    *)
      return 1
      ;;
  esac
}

health_check() {
  local endpoint attempt
  local endpoints=(/health /auth/health /processing/health /ingest/health /dashboard/health /)

  for endpoint in "${endpoints[@]}"; do
    for attempt in $(seq 1 "$HEALTH_CHECK_ATTEMPTS"); do
      if curl --fail --silent --show-error --max-time 15 \
        --output /dev/null "$HEALTH_BASE_URL$endpoint"; then
        break
      fi
      [[ "$attempt" -eq "$HEALTH_CHECK_ATTEMPTS" ]] && return 1
      sleep "$HEALTH_CHECK_DELAY_SECONDS"
    done
  done
}

deploy_services() {
  local selected_release="$1"
  shift
  local -a target_services=("$@")
  local -a build_targets=()
  local service require_seo_snapshot=0

  for service in "${target_services[@]}"; do
    [[ "$service" != "nginx" ]] && build_targets+=("$service")
    [[ "$service" == "dashboard-frontend" ]] && require_seo_snapshot=1
  done

  compose_for_release "$selected_release" config --quiet
  if [[ ${#build_targets[@]} -gt 0 ]]; then
    SEO_REQUIRE_SNAPSHOT="$require_seo_snapshot" compose_for_release "$selected_release" build --pull "${build_targets[@]}"
  fi
  if [[ ${#target_services[@]} -gt 0 ]]; then
    compose_for_release "$selected_release" up -d --force-recreate --no-deps "${target_services[@]}"
  fi
}

generate_frontend_seo_snapshot() {
  local selected_release="$1"
  local snapshot_dir="$RELEASE_ROOT/$selected_release/dashboard-frontend/.seo-snapshot"
  local snapshot_file="$snapshot_dir/stations.json"
  local temporary_file

  install -d -m 0700 "$snapshot_dir"
  temporary_file="$(mktemp "$snapshot_dir/.stations.XXXXXX")"

  if ! curl --fail --silent --show-error --max-time 15 --max-filesize 1048576 \
    --output "$temporary_file" "$HEALTH_BASE_URL/dashboard/seo/stations"; then
    rm -f "$temporary_file"
    return 1
  fi

  # El contenido se valida estrictamente por el prerenderizador. Aquí no se
  # registra ni muestra el catálogo para no ampliar los logs de despliegue.
  mv -f "$temporary_file" "$snapshot_file"
}

verify_service_provenance() {
  local selected_release="$1"
  shift
  local service container_id running_label expected_image actual_image expected_image_id

  for service in "$@"; do
    container_id="$(compose_for_release "$selected_release" ps -q "$service")"
    if [[ -z "$container_id" ]]; then
      log "No running container found for $service"
      return 1
    fi
    if [[ "$(docker inspect --format '{{.State.Running}}' "$container_id")" != "true" ]]; then
      log "$service is not running"
      return 1
    fi

    running_label="$(docker inspect --format "{{ index .Config.Labels \"$RELEASE_LABEL\" }}" "$container_id")"
    if [[ "$running_label" != "$selected_release" ]]; then
      log "$service does not carry release $selected_release"
      return 1
    fi

    if expected_image="$(service_image "$service" "$selected_release")"; then
      actual_image="$(docker inspect --format '{{.Image}}' "$container_id")"
      expected_image_id="$(docker image inspect --format '{{.Id}}' "$expected_image")"
      if [[ "$actual_image" != "$expected_image_id" ]]; then
        log "$service is not running image $expected_image"
        return 1
      fi
    fi
  done
}

verify_frontend_build_info() {
  local selected_release="$1"
  local build_info
  if ! build_info="$(curl --fail --silent --show-error --max-time 15 "$HEALTH_BASE_URL/build-info.json")"; then
    log "Frontend build-info.json is unavailable"
    return 1
  fi
  if [[ "$build_info" != "{\"commitSha\":\"$selected_release\"}" ]]; then
    log "Frontend build-info.json does not match release $selected_release"
    return 1
  fi
}

record_service_release() {
  local service="$1"
  local selected_release="$2"
  local previous_release="$3"
  local service_dir previous_state current_state
  service_dir="$SERVICE_STATE_ROOT/$service"
  previous_state="$(service_state_file "$service" previous)"
  current_state="$(service_state_file "$service" current)"

  install -d -m 0700 "$service_dir"
  if [[ "$previous_release" != "$selected_release" ]]; then
    printf '%s\n' "$previous_release" > "$previous_state"
  fi
  printf '%s\n' "$selected_release" > "$current_state"
}

is_full_reconciliation() {
  [[ "$(IFS=,; echo "${services[*]}")" == "auth-service,noise-processing,ingestion-api,dashboard-api,dashboard-frontend,nginx" ]]
}

record_global_release() {
  if [[ -n "$current_release" && "$current_release" != "$commit_sha" ]]; then
    printf '%s\n' "$current_release" > "$previous_file"
  fi
  printf '%s\n' "$commit_sha" > "$current_file"
}

rollback() {
  local service selected_release
  local -a rollback_services
  declare -A rollback_groups=()

  for service in "${services[@]}"; do
    selected_release="${previous_releases[$service]}"
    [[ -n "$selected_release" ]] || die "no rollback release is available for $service"
    rollback_groups["$selected_release"]+="${rollback_groups[$selected_release]:+,}$service"
  done

  for selected_release in "${!rollback_groups[@]}"; do
    IFS=',' read -r -a rollback_services <<< "${rollback_groups[$selected_release]}"
    log "Rolling back ${rollback_groups[$selected_release]} to $selected_release"
    deploy_services "$selected_release" "${rollback_services[@]}"
  done

  health_check
}

if [[ ${#services[@]} -gt 0 ]]; then
  declare -A previous_releases=()
  for service in "${services[@]}"; do
    previous_releases["$service"]="$(service_release "$service")"
  done

  log "Deploying services: ${services[*]}"
  if [[ " ${services[*]} " == *" dashboard-frontend " ]]; then
    preliminary_services=()
    for service in "${services[@]}"; do
      [[ "$service" != "dashboard-frontend" ]] && preliminary_services+=("$service")
    done

    if [[ ${#preliminary_services[@]} -gt 0 ]] && ! deploy_services "$commit_sha" "${preliminary_services[@]}"; then
      log "Build or service start failed before SEO snapshot generation."
      rollback || log "Rollback could not be completed."
      exit 1
    fi

    if ! health_check || ! generate_frontend_seo_snapshot "$commit_sha" || ! deploy_services "$commit_sha" dashboard-frontend; then
      log "SEO snapshot generation or frontend publication failed."
      rollback || log "Rollback could not be completed."
      exit 1
    fi
  elif ! deploy_services "$commit_sha" "${services[@]}"; then
    log "Build or service start failed before release activation."
    rollback || log "Rollback could not be completed."
    exit 1
  fi

  if ! health_check; then
    log "Post-deployment health checks failed."
    rollback || log "Rollback could not be completed."
    exit 1
  fi

  if ! verify_service_provenance "$commit_sha" "${services[@]}"; then
    log "Container provenance verification failed."
    rollback || log "Rollback could not be completed."
    exit 1
  fi

  if [[ " ${services[*]} " == *" dashboard-frontend " ]] && ! verify_frontend_build_info "$commit_sha"; then
    log "Frontend provenance verification failed."
    rollback || log "Rollback could not be completed."
    exit 1
  fi

  for service in "${services[@]}"; do
    record_service_release "$service" "$commit_sha" "${previous_releases[$service]}"
  done

  if is_full_reconciliation; then
    record_global_release
  fi
else
  log "No deployable VPS service changed; release archived without changing active state."
fi

rm -f "$archive_path"
log "Deployment completed for $commit_sha"
