# =============================================================================
# Variables de entorno — Sistema de Monitoreo Acústico Binaural
# Copiar como .env y completar los valores antes de ejecutar docker-compose up
# =============================================================================

# ── Bases de datos ─────────────────────────────────────────────────────────────

# noise_analytics (métricas acústicas)
POSTGRES_NOISE_DB=noise_analytics
POSTGRES_NOISE_USER=noise_user
POSTGRES_NOISE_PASSWORD=change_this_password

# station_registry (autenticación)
POSTGRES_AUTH_DB=station_registry
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=change_this_password

# ── Auth Service ───────────────────────────────────────────────────────────────

# Clave secreta para firmar JWT. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 32
JWT_SECRET=change_this_to_a_random_secret_of_at_least_32_chars

# Días de validez de cada token JWT
JWT_EXPIRATION_DAYS=30

# Clave de administración para endpoints /admin/* en Auth Service y Noise Processing
ADMIN_API_KEY=change_this_admin_api_key

# ── Puertos expuestos al host ──────────────────────────────────────────────────
# Solo Nginx y las bases de datos son accesibles desde fuera de Docker.
# Los backends viven únicamente dentro de la red interna.

NGINX_PORT=80
POSTGRES_NOISE_EXTERNAL_PORT=5433
POSTGRES_AUTH_EXTERNAL_PORT=5434
