# =============================================================================
# docker/.env — Variables de entorno producción
# Sistema de Monitoreo Acústico Binaural
# =============================================================================

# ── Bases de datos ────────────────────────────────────────────────────────────
POSTGRES_NOISE_DB=noise_analytics
POSTGRES_NOISE_USER=noise_user
POSTGRES_NOISE_PASSWORD=<cambiar_por_password_seguro>

POSTGRES_AUTH_DB=station_registry
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=<cambiar_por_password_seguro>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar cada valor por separado con: openssl rand -base64 48
# Deben ser diferentes. Nunca reutilizar el antiguo JWT_SECRET compartido.
STATION_JWT_SECRET=<mínimo_32_bytes_aleatorios>
ADMIN_JWT_SECRET=<mínimo_32_bytes_aleatorios_distintos>

# Expiración del token de estaciones Raspberry Pi (días)
JWT_EXPIRATION_DAYS=30

# Expiración del token de administradores humanos (horas)
# Sesión interactiva — más corta por seguridad
ADMIN_JWT_EXPIRATION_HOURS=8

# Único origen autorizado para llamadas administrativas desde el navegador.
CORS_ALLOWED_ORIGIN=https://soundmonitoring.systems

# Ver ../sql/manage_super_admin.sh para crear o rotar el superadministrador.

# ── Gateway Docker ────────────────────────────────────────────────────────────
# Solo se publica en 127.0.0.1. Nginx + Certbot de la VPS exponen 80/443.
NGINX_PORT=8080

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=https://soundmonitoring.systems/dashboard
# Key pública de MapTiler, restringida al dominio de la aplicación.
VITE_MAPTILER_KEY=<key_de_maptiler>

# ── Desarrollo local (ignoradas en producción sin override.yml) ───────────────
POSTGRES_NOISE_EXTERNAL_PORT=5433
POSTGRES_AUTH_EXTERNAL_PORT=5434
