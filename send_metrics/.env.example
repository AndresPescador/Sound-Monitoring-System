# =============================================================================
# send_metrics — Variables de entorno
# Copiar como .env y completar antes de ejecutar
# =============================================================================

# ── Identidad de esta estación ─────────────────────────────────────────────────
# Deben coincidir exactamente con los registrados en el Auth Service
STATION_CODE=ST-CHAPINERO-01
STATION_SECRET=el_secret_obtenido_al_registrar_la_estacion

# ── URLs del servidor central (Servidor) ───────────────────────
# Reemplazar con la IP del PC donde corre el servidor
# Ejemplo red local: http://192.168.1.100
# Si el servidor usa un puerto distinto al 80: http://192.168.1.100:8080
SERVER_URL=http://localhost

# ── Runtime local (fuera del código fuente) ────────────────────────────────────
# Se resuelve relativo a la raíz de send_metrics si no es una ruta absoluta.
RUNTIME_DIR=./runtime

# Carpeta compartida por process_audio.py y send_metrics.py.
METRICS_OUTPUT_DIR=./runtime/audio_stats

# ── Comportamiento ─────────────────────────────────────────────────────────────
# Segundos entre cada ciclo de envío
SEND_INTERVAL_SECONDS=30

# Máximo de reintentos por archivo antes de marcarlo como fallido
MAX_RETRIES=3

# Máximo de archivos del backlog a enviar por ciclo (evita saturar si hay
# muchos acumulados por haber estado apagado)
MAX_BACKLOG=100
