[Unit]
Description=Grabador continuo de Sound Monitor
After=sound.target local-fs.target
Wants=sound.target

[Service]
Type=simple
User=pi
Group=pi
RuntimeDirectory=continuous-recorder
RuntimeDirectoryMode=0750
WorkingDirectory=/home/pi/Sound-Monitoring-System/send_metrics/recorder
Environment=SOUND_MONITOR_CONFIG=/home/pi/.config/sound-monitor/station.toml
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
ExecStart=/usr/local/bin/continuous-recorder record --config /home/pi/.config/sound-monitor/station.toml
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
