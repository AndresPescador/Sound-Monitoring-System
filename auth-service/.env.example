DB_URL=jdbc:postgresql://localhost:5432/station_registry
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Generar cada valor por separado con: openssl rand -base64 48
STATION_JWT_SECRET=replace_with_an_independent_random_value
ADMIN_JWT_SECRET=replace_with_a_different_random_value
JWT_EXPIRATION_DAYS=30
ADMIN_JWT_EXPIRATION_HOURS=8

CORS_ALLOWED_ORIGIN=http://localhost:3000
PORT=8081
